
<?xml version='1.0' encoding='utf-8'?>

<widget
    id="com.transparencia.pnt"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>AppPNT</name>

    <description>
        Buscador de Transparencia PNT
    </description>

    <author email="dev@apache.org" href="https://cordova.apache.org">
        AppPNT
    </author>

    <content src="index.html" />

    <!-- Configuración Android -->
    <preference name="AndroidXEnabled" value="true" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
    <preference name="LogLevel" value="DEBUG" />

    <!-- Pantalla -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- Acceso a internet -->
    <access origin="https://datos.gob.mx" />

    <access origin="https://*" />

    <!-- Navegación -->
    <allow-navigation href="https://datos.gob.mx/*" />
    <allow-navigation href="https://*/*" />

    <!-- Enlaces externos -->
    <allow-intent href="https://*/*" />
    <allow-intent href="http://*/*" />

    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

</widget>
